<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#173F73"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SMARTBILL  /  BILLING"
            android:textColor="#BBD7FF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create New Bill"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginTop="7dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select products and collect payment"
            android:textColor="#DFEAF8"
            android:textSize="13sp"
            android:layout_marginTop="4dp"/>

    </LinearLayout>

    <!-- Main Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp">

        <!-- Products Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.2"
            android:orientation="vertical"
            android:background="@drawable/bg_product_card"
            android:padding="12dp">

            <!-- Section Heading -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Available Products"
                android:textColor="#17324D"
                android:textSize="17sp"
                android:textStyle="bold"
                android:paddingBottom="6dp"/>

            <!-- Search -->
            <EditText
                android:id="@+id/etSearchProduct"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_dashboard_tile"
                android:hint="Search products..."
                android:inputType="text"
                android:singleLine="true"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="#17324D"
                android:textColorHint="#667085"
                android:textSize="14sp"
                android:drawablePadding="8dp"/>

            <!-- Product List -->
            <ListView
                android:id="@+id/listAvailableProducts"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:divider="#E9EEF5"
                android:dividerHeight="1dp"
                android:background="@android:color/transparent"
                android:clipToPadding="false"
                android:paddingBottom="4dp"/>

        </LinearLayout>

        <!-- Cart Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.8"
            android:orientation="vertical"
            android:background="@drawable/bg_product_card"
            android:padding="12dp"
            android:layout_marginTop="10dp">

            <!-- Cart Heading -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your Cart"
                android:textColor="#17324D"
                android:textSize="17sp"
                android:textStyle="bold"
                android:paddingBottom="6dp"/>

            <!-- Cart List -->
            <ListView
                android:id="@+id/listCartItems"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:divider="#E9EEF5"
                android:dividerHeight="1dp"
                android:background="@android:color/transparent"
                android:clipToPadding="false"
                android:paddingBottom="4dp"/>

        </LinearLayout>

    </LinearLayout>

    <!-- Bottom Payment Panel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:elevation="10dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <!-- Total Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GRAND TOTAL"
                    android:textColor="#667085"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Amount to collect"
                    android:textColor="#667085"
                    android:textSize="12sp"
                    android:layout_marginTop="3dp"/>

            </LinearLayout>

            <TextView
                android:id="@+id/txtTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹0.00"
                android:textColor="#173F73"
                android:textSize="27sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <!-- UPI Payment Button -->
        <Button
            android:id="@+id/btnGenerateQR"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="Generate UPI QR"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:background="@drawable/bg_button_upi"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:elevation="2dp" />

        <!-- Cash Payment Button -->
        <Button
            android:id="@+id/btnCashPayment"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="Complete Cash Payment"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:background="@drawable/bg_button_cash"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:elevation="2dp" />

    </LinearLayout>

</LinearLayout>